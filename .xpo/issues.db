{"id":"tuido-7f6eaf","type":"CREATE","payload":{"title":"README demo GIF recorded with VHS","description":"Add a scripted VHS tape (`demo/demo.tape`) that records a short tuido demo GIF, and embed it at the top of the README. Recording must use an isolated throwaway HOME so it never touches the real `~/.config/tuido/todos.json`.","status":"PLANNED","estimate":1,"sort_order":"a0","labels":["task","docs"]},"created_at":"2026-10-02T13:26:25.716829Z","created_by":"claude-code/2.1.287 \u003cagent@mcp\u003e","on_behalf_of":"Nicolas Bettenburg \u003cnicbet@gmail.com\u003e","source":"mcp"}
